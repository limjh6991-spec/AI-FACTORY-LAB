# =====================================================
# SpacePro Docker Environment Variables
# =====================================================
# 이 파일을 .env로 복사하여 사용하세요:
# cp .env.docker .env
# =====================================================

# -------------------------------------------------
# PostgreSQL Database
# -------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spacepro

# -------------------------------------------------
# Service Ports
# -------------------------------------------------
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3001

# -------------------------------------------------
# Application Settings
# -------------------------------------------------
NODE_ENV=production

# Database URL (컨테이너 내부용)
DATABASE_URL=postgresql://postgres:postgres@db:5432/spacepro?schema=spacepro

# Backend API URL (브라우저에서 접근)
NEXT_PUBLIC_API_URL=http://localhost:8000
