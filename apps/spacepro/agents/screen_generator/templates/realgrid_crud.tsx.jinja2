{# RealGrid CRUD 화면 템플릿 #}
/**
 * {{ screen_name }} 화면
 * 자동 생성됨 - {{ table_name }}
 */

'use client';

import React, { useEffect, useRef, useState } from 'react';
import { GridView, LocalDataProvider, ValueType } from 'realgrid';
import 'realgrid/dist/realgrid-style.css';
import { Save, Plus, Trash2, RefreshCw, Search } from 'lucide-react';

export default function {{ screen_name | replace(' ', '') }}Page() {
    const gridRef = useRef<HTMLDivElement>(null);
    const [gridView, setGridView] = useState<GridView | null>(null);
    const [dataProvider, setDataProvider] = useState<LocalDataProvider | null>(null);
    {% if use_search %}
    const [searchKeyword, setSearchKeyword] = useState('');
    {% endif %}

    // 컬럼 정의
    const fields = [
        {% for col in columns %}
        { fieldName: '{{ col.name }}', dataType: ValueType.{% if col.type == 'number' %}NUMBER{% elif col.type == 'date' %}DATETIME{% else %}TEXT{% endif %} },
        {% endfor %}
    ];

    const columns = [
        {% for col in columns %}
        {
            name: '{{ col.name }}',
            fieldName: '{{ col.name }}',
            header: { text: '{{ col.label }}' },
            width: {{ col.width }},
            editable: {{ 'true' if col.editable else 'false' }},
            {% if col.required %}
            styles: { background: '#FFF9C4' },
            {% endif %}
        },
        {% endfor %}
    ];

    // 그리드 초기화
    useEffect(() => {
        if (!gridRef.current) return;

        const provider = new LocalDataProvider(true);
        const grid = new GridView(gridRef.current);
        
        provider.setFields(fields);
        grid.setColumns(columns);
        grid.setDataSource(provider);

        // 그리드 옵션
        grid.setEditOptions({
            insertable: true,
            appendable: true,
            deletable: true,
        });

        grid.setStateBar({ visible: true });
        grid.setCheckBar({ visible: true });

        setDataProvider(provider);
        setGridView(grid);

        // 데이터 로드
        fetchData(provider);

        return () => {
            grid.destroy();
            provider.destroy();
        };
    }, []);

    // 데이터 조회
    const fetchData = async (provider?: LocalDataProvider) => {
        const dp = provider || dataProvider;
        if (!dp) return;

        try {
            const response = await fetch('/api{{ screen_path }}{% if use_search %}?keyword=' + searchKeyword{% endif %}');
            const data = await response.json();
            dp.setRows(data);
        } catch (error) {
            console.error('데이터 조회 오류:', error);
        }
    };

    // 저장
    const handleSave = async () => {
        if (!dataProvider || !gridView) return;
        
        gridView.commit();
        const rows = dataProvider.getJsonRows();
        
        try {
            await fetch('/api{{ screen_path }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(rows),
            });
            alert('저장되었습니다.');
            fetchData();
        } catch (error) {
            console.error('저장 오류:', error);
            alert('저장 중 오류가 발생했습니다.');
        }
    };

    // 행 추가
    const handleAdd = () => {
        dataProvider?.insertRow(0, {});
        gridView?.setCurrent({ itemIndex: 0 });
        gridView?.setFocus();
    };

    // 행 삭제
    const handleDelete = () => {
        const checkedRows = gridView?.getCheckedRows() || [];
        if (checkedRows.length === 0) {
            alert('삭제할 행을 선택하세요.');
            return;
        }
        dataProvider?.removeRows(checkedRows);
    };

    return (
        <div className="min-h-screen p-6 bg-gray-100">
            <div className="bg-white rounded-xl shadow-sm">
                {/* 헤더 */}
                <div className="p-4 border-b flex justify-between items-center">
                    <h1 className="text-xl font-bold text-gray-900">
                        📋 {{ screen_name }}
                    </h1>
                    <div className="flex gap-2">
                        <button
                            onClick={handleAdd}
                            className="px-3 py-2 bg-green-500 text-white rounded-lg text-sm flex items-center gap-1"
                        >
                            <Plus className="w-4 h-4" /> 추가
                        </button>
                        <button
                            onClick={handleDelete}
                            className="px-3 py-2 bg-red-500 text-white rounded-lg text-sm flex items-center gap-1"
                        >
                            <Trash2 className="w-4 h-4" /> 삭제
                        </button>
                        <button
                            onClick={handleSave}
                            className="px-3 py-2 bg-blue-500 text-white rounded-lg text-sm flex items-center gap-1"
                        >
                            <Save className="w-4 h-4" /> 저장
                        </button>
                    </div>
                </div>

                {% if use_search %}
                {/* 검색 영역 */}
                <div className="p-4 border-b flex gap-2">
                    <input
                        type="text"
                        placeholder="검색어 입력..."
                        value={searchKeyword}
                        onChange={(e) => setSearchKeyword(e.target.value)}
                        className="flex-1 px-3 py-2 border rounded-lg"
                        onKeyPress={(e) => e.key === 'Enter' && fetchData()}
                    />
                    <button
                        onClick={() => fetchData()}
                        className="px-4 py-2 bg-gray-100 rounded-lg flex items-center gap-1"
                    >
                        <Search className="w-4 h-4" /> 조회
                    </button>
                    <button
                        onClick={() => { setSearchKeyword(''); fetchData(); }}
                        className="px-4 py-2 bg-gray-100 rounded-lg flex items-center gap-1"
                    >
                        <RefreshCw className="w-4 h-4" /> 초기화
                    </button>
                </div>
                {% endif %}

                {/* 그리드 */}
                <div ref={gridRef} style={% raw %}{{ height: 500 }}{% endraw %} />
            </div>
        </div>
    );
}
