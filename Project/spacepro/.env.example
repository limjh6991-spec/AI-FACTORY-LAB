# =====================================================
# SpacePro MES/MRP - 환경 변수 템플릿
# =====================================================
# 이 파일을 복사하여 .env 파일을 생성하세요:
# cp .env.example .env
# =====================================================

# -----------------------------------------------------
# 🔧 Database Configuration (필수)
# -----------------------------------------------------
# PostgreSQL 연결 문자열
# 형식: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/binary?schema=spacepro"

# -----------------------------------------------------
# 🌐 Application Settings
# -----------------------------------------------------
# 실행 환경: development | production | test
NODE_ENV=development

# 서버 포트 (기본: 3001)
PORT=3001

# 앱 URL (프로덕션에서 실제 URL로 변경)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# -----------------------------------------------------
# 🔐 Authentication (Phase 3+)
# -----------------------------------------------------
# JWT 시크릿 키 (32자 이상 권장)
# JWT_SECRET=your-super-secret-jwt-key-here-min-32-chars

# 세션 만료 시간 (초)
# SESSION_TIMEOUT=3600

# -----------------------------------------------------
# 📊 OR-Tools Scheduling Service (Phase 2+)
# -----------------------------------------------------
# Python 스케줄링 마이크로서비스 URL
# SCHEDULING_SERVICE_URL=http://localhost:8000

# 스케줄링 타임아웃 (초)
# SCHEDULING_TIMEOUT=60

# -----------------------------------------------------
# 📧 Notification Settings (Phase 3+)
# -----------------------------------------------------
# 슬랙 웹훅 URL
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# 이메일 서버 설정
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password

# -----------------------------------------------------
# 📁 File Storage (Phase 3+)
# -----------------------------------------------------
# 파일 업로드 경로
# UPLOAD_PATH=/uploads

# 최대 파일 크기 (MB)
# MAX_FILE_SIZE=10
