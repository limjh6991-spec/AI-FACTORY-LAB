// SpacePro MES/MRP Schema
// PostgreSQL with spacepro schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["spacepro"]
}

// ============================================
// 메뉴 관리 테이블
// ============================================

/// 메뉴 마스터 테이블
model Menu {
  id          Int       @id @default(autoincrement())
  menuCode    String    @unique @map("menu_code") @db.VarChar(20)
  menuName    String    @map("menu_name") @db.VarChar(100)
  menuNameEn  String?   @map("menu_name_en") @db.VarChar(100)
  menuPath    String?   @map("menu_path") @db.VarChar(200)
  menuIcon    String?   @map("menu_icon") @db.VarChar(50)
  parentId    Int?      @map("parent_id")
  menuLevel   Int       @default(1) @map("menu_level")
  sortOrder   Int       @default(0) @map("sort_order")
  menuType    String    @default("MENU") @map("menu_type") @db.VarChar(20) // MENU, GROUP, LINK
  isActive    Boolean   @default(true) @map("is_active")
  description String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Self-relation for parent-child
  parent      Menu?     @relation("MenuHierarchy", fields: [parentId], references: [id])
  children    Menu[]    @relation("MenuHierarchy")

  @@map("tb_menu_mst")
  @@schema("spacepro")
}

// ============================================
// 기준정보 테이블 (Phase 2)
// ============================================

/// 품목 마스터
model Item {
  id            Int       @id @default(autoincrement())
  itemCode      String    @unique @map("item_code") @db.VarChar(50)
  itemName      String    @map("item_name") @db.VarChar(200)
  itemType      String    @map("item_type") @db.VarChar(20) // RAW, SEMI, PRODUCT
  unit          String    @map("unit") @db.VarChar(20)
  leadTime      Int?      @default(0) @map("lead_time")
  safetyStock   Decimal?  @default(0) @map("safety_stock") @db.Decimal(15, 3)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("tb_item_mst")
  @@schema("spacepro")
}

/// BOM 마스터
model Bom {
  id            Int       @id @default(autoincrement())
  parentItem    String    @map("parent_item") @db.VarChar(50)
  childItem     String    @map("child_item") @db.VarChar(50)
  bomLevel      Int       @default(1) @map("bom_level")
  quantity      Decimal   @default(1) @map("quantity") @db.Decimal(15, 5)
  lossRate      Decimal?  @default(0) @map("loss_rate") @db.Decimal(5, 2)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([parentItem, childItem])
  @@map("tb_bom_mst")
  @@schema("spacepro")
}

/// 공정 마스터
model Process {
  id            Int       @id @default(autoincrement())
  processCode   String    @unique @map("process_code") @db.VarChar(50)
  processName   String    @map("process_name") @db.VarChar(200)
  workCenter    String?   @map("work_center") @db.VarChar(50)
  stdTime       Decimal?  @default(0) @map("std_time") @db.Decimal(10, 2)
  setupTime     Decimal?  @default(0) @map("setup_time") @db.Decimal(10, 2)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("tb_process_mst")
  @@schema("spacepro")
}

/// 설비 마스터
model Machine {
  id            Int       @id @default(autoincrement())
  machineCode   String    @unique @map("machine_code") @db.VarChar(50)
  machineName   String    @map("machine_name") @db.VarChar(200)
  machineType   String?   @map("machine_type") @db.VarChar(50)
  manufacturer  String?   @map("manufacturer") @db.VarChar(100)
  uph           Int?      @default(0) @map("uph")
  efficiency    Decimal?  @default(100) @map("efficiency") @db.Decimal(5, 2)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("tb_machine_mst")
  @@schema("spacepro")
}

/// 작업자 마스터
model Worker {
  id            Int       @id @default(autoincrement())
  workerCode    String    @unique @map("worker_code") @db.VarChar(50)
  workerName    String    @map("worker_name") @db.VarChar(100)
  department    String?   @map("department") @db.VarChar(100)
  position      String?   @map("position") @db.VarChar(50)
  shiftGroup    String?   @map("shift_group") @db.VarChar(20)
  skillLevel    String?   @map("skill_level") @db.VarChar(20)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("tb_worker_mst")
  @@schema("spacepro")
}
